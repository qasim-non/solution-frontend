# Frontend SPA nginx config (template).
# $PORT is substituted at container start by nginx's envsubst (Railway/Heroku set it).
server {
    listen $PORT;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # SPA routing - always serve index.html for client-side routes
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Static assets caching
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Prevent access to hidden files
    location ~ /\.(?!well-known).* {
        deny all;
    }
}
