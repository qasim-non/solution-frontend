# Frontend production nginx config (template)
# __BACKEND_URL__ and __PORT__ are substituted at container start by the entrypoint (sed).
# Serves React SPA and reverse-proxies /api & /sanctum to the Laravel backend.
server {
    listen __PORT__;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Service worker must always be revalidated so push handling updates ship.
    location = /firebase-messaging-sw.js {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        try_files $uri =404;
    }

    # SPA routing
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Reverse proxy API calls to the Laravel backend.
    # Uses a runtime resolver + variable so nginx re-resolves the host per request
    # (fixes "curl works but nginx 502s" caused by stale DNS at startup).
    location ~ ^/(api|sanctum) {
        resolver 1.1.1.1 valid=30s ipv6=off;
        set $backend __BACKEND_URL__;
        proxy_pass $backend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 30s;
    }

    # Static assets caching
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Prevent access to hidden files
    location ~ /\.ht {
        deny all;
    }
}
